@model EmployeeViewModel
@{
    ViewData["Title"] = Model.FullName + " — 編集";
}

@section Breadcrumb {
  <div class="breadcrumb">
    <div class="page-icon">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    </div>
    <a class="bc-link" asp-controller="Employee" asp-action="Index">社員一覧</a>
    <span class="bc-sep">›</span>
    <a class="bc-link" asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.Id">@Model.FullName</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">編集</span>
  </div>
}

<div class="fade-up" style="max-width:700px">
  <div class="form-card">
    <div class="form-card-header">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
      社員情報の編集
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-body">
      @Html.AntiForgeryToken()

      <div style="display:flex;gap:28px;align-items:flex-start;margin-bottom:24px">
        <!-- 画像アップロード -->
        <div style="flex-shrink:0;text-align:center">
          <div class="upload-circle" onclick="document.getElementById('imgInput').click()" id="uploadArea">
            @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
            {
              <img id="imgPreview" class="upload-preview" src="@Model.ProfileImagePath" alt="">
            }
            else
            {
              <img id="imgPreview" class="upload-preview" src="" alt="" style="display:none">
            }
            <svg id="uploadIcon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 style="opacity:.3;@(!string.IsNullOrEmpty(Model.ProfileImagePath) ? "display:none" : "")">
              <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
            </svg>
            <span id="uploadLabel" style="font-size:10px;color:var(--text-soft);text-align:center;line-height:1.5;@(!string.IsNullOrEmpty(Model.ProfileImagePath) ? "display:none" : "")">
              クリックして<br>画像を変更
            </span>
            @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
            {
              <span style="position:absolute;bottom:4px;font-size:9px;color:var(--text-soft);background:rgba(255,255,255,.8);padding:2px 6px;border-radius:4px">変更する</span>
            }
          </div>
          <input type="file" id="imgInput" asp-for="ProfileImageFile" accept="image/*" style="display:none" onchange="previewImg(this)">
          <p style="font-size:10px;color:var(--text-soft);margin-top:8px">プロフィール画像</p>
        </div>

        <div style="flex:1">
          <!-- 社員番号（変更不可） -->
          <div class="form-group">
            <label class="form-label">社員番号</label>
            <input type="text" value="@Model.EmployeeNo" class="form-control" readonly
              style="background:#f7f7f5;color:var(--text-soft);cursor:not-allowed;font-family:var(--mono)">
            <small style="color:var(--text-soft);font-size:11px;margin-top:3px">🔒 変更不可</small>
          </div>

          <!-- 氏名 -->
          <div class="form-group">
            <label class="form-label">氏名<span class="req">*</span></label>
            <div class="form-row">
              <div>
                <input asp-for="LastName" class="form-control" placeholder="例）山田">
                <span asp-validation-for="LastName" class="field-validation-error"></span>
              </div>
              <div>
                <input asp-for="FirstName" class="form-control" placeholder="例）太郎">
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- メールアドレス -->
      <div class="form-group">
        <label class="form-label" asp-for="Email">メールアドレス<span class="req">*</span></label>
        <input asp-for="Email" type="email" class="form-control">
        <span asp-validation-for="Email" class="field-validation-error"></span>
      </div>

      <!-- 電話番号 / 部門 -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" asp-for="Phone">電話番号<span class="req">*</span></label>
          <input asp-for="Phone" class="form-control" style="font-family:var(--mono)">
          <span asp-validation-for="Phone" class="field-validation-error"></span>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="DeptId">部門<span class="req">*</span></label>
          <select asp-for="DeptId" asp-items="ViewBag.Departments" class="form-control">
            <option value="">選択してください</option>
          </select>
          <span asp-validation-for="DeptId" class="field-validation-error"></span>
        </div>
      </div>

      <!-- 在籍状態 / 入社日 -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" asp-for="Status">在籍状態<span class="req">*</span></label>
          <select asp-for="Status" class="form-control">
            <option value="">選択してください</option>
            <option value="1">在籍</option>
            <option value="2">休職</option>
            <option value="3">退職</option>
          </select>
          <span asp-validation-for="Status" class="field-validation-error"></span>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="HireDate">入社日</label>
          <input asp-for="HireDate" type="date" class="form-control">
        </div>
      </div>

      <!-- 生年月日 -->
      <div class="form-group" style="max-width:50%;padding-right:8px">
        <label class="form-label" asp-for="BirthDate">生年月日<span class="req">*</span></label>
        <input asp-for="BirthDate" type="date" class="form-control">
        <span asp-validation-for="BirthDate" class="field-validation-error"></span>
      </div>

      <div class="form-footer" style="margin:0 -28px -28px;padding:16px 28px">
        <a class="btn btn-secondary" asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.Id">キャンセル</a>
        <button type="submit" class="btn btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          更新
        </button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
<script>
function previewImg(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const prev = document.getElementById('imgPreview');
    prev.src = e.target.result;
    prev.style.display = 'block';
    document.getElementById('uploadIcon').style.display = 'none';
    document.getElementById('uploadLabel').style.display = 'none';
  };
  reader.readAsDataURL(file);
}
</script>
}
