@model EmployeeViewModel
@{
    ViewData["Title"] = Model.FullName + " — " + L["Page.EmployeeEdit"];
}

@if (ViewBag.IsMobile == true)
{
  <div class="m-fade-up">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
      @Html.AntiForgeryToken()

      <!-- 画像 -->
      <div class="m-card" style="margin-bottom:12px">
        <div class="m-upload" onclick="document.getElementById('mImgInput').click()">
          <div class="m-upload-circle">
            @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
            { <img src="@Model.ProfileImagePath" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%"> }
            else
            { <div class="m-avatar m-avatar-xl">@(Model.LastName?.FirstOrDefault().ToString() ?? "?")</div> }
            <img id="mImgPreview" src="" alt="" style="display:none;width:100%;height:100%;object-fit:cover;border-radius:50%;position:absolute;inset:0">
          </div>
          <div style="font-size:14px;font-weight:500;color:var(--text-mid)">@L["Label.ProfileImage"]</div>
          <div style="font-size:12px;color:var(--text-soft)">タップして変更</div>
        </div>
        <input type="file" id="mImgInput" asp-for="ProfileImageFile" accept="image/*" style="display:none" onchange="mPreviewImg(this)">
      </div>

      <!-- 基本情報 -->
      <div class="m-section-title">@L["Label.BasicInfo"]</div>
      <div class="m-card" style="margin-bottom:12px;padding:16px">
        <div class="m-form-group">
          <label class="m-form-label">@L["Label.EmployeeNo"]</label>
          <input type="text" value="@Model.EmployeeNo" class="m-form-input" readonly style="background:#f0f0f0;color:var(--text-soft)">
          <div class="m-form-hint">🔒 @L["Msg.ReadOnly"]</div>
        </div>
        <div class="m-form-group">
          <label class="m-form-label">@L["Label.FullName"] <span class="req" style="color:var(--danger)">*</span></label>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <input asp-for="LastName" class="m-form-input" placeholder="@L["Label.LastName"]">
            <input asp-for="FirstName" class="m-form-input" placeholder="@L["Label.FirstName"]">
          </div>
        </div>
        <div class="m-form-group">
          <label class="m-form-label">@L["Label.FullName"] <span class="en-badge">EN</span></label>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <input asp-for="FirstNameEn" class="m-form-input" placeholder="e.g. Taro">
            <input asp-for="LastNameEn" class="m-form-input" placeholder="e.g. Yamada">
          </div>
          <div class="m-form-hint">@L["Label.EnNameOptional"]</div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="m-form-group">
            <label class="m-form-label">@L["Label.BirthDate"] <span class="req" style="color:var(--danger)">*</span></label>
            <input asp-for="BirthDate" type="date" class="m-form-input">
          </div>
          <div class="m-form-group">
            <label class="m-form-label">@L["Label.HireDate"]</label>
            <input asp-for="HireDate" type="date" class="m-form-input">
          </div>
        </div>
      </div>

      <!-- 連絡先 -->
      <div class="m-section-title">@L["Label.Contact"]</div>
      <div class="m-card" style="margin-bottom:12px;padding:16px">
        <div class="m-form-group">
          <label class="m-form-label">@L["Label.Email"] <span class="req" style="color:var(--danger)">*</span></label>
          <input asp-for="Email" type="email" class="m-form-input">
        </div>
        <div class="m-form-group">
          <label class="m-form-label">@L["Label.Phone"] <span class="req" style="color:var(--danger)">*</span></label>
          <input asp-for="Phone" class="m-form-input" style="font-family:var(--mono)">
        </div>
      </div>

      <!-- 所属 -->
      <div class="m-section-title">@L["Label.Affiliation"]</div>
      <div class="m-card" style="margin-bottom:24px;padding:16px">
        <div class="m-form-group">
          <label class="m-form-label">@L["Label.Department"] <span class="req" style="color:var(--danger)">*</span></label>
          <select asp-for="DeptId" asp-items="ViewBag.Departments" class="m-form-input">
            <option value="">@L["Hint.Select"]</option>
          </select>
        </div>
        <div class="m-form-group">
          <label class="m-form-label">@L["Label.Status"] <span class="req" style="color:var(--danger)">*</span></label>
          <select asp-for="Status" class="m-form-input">
            <option value="">@L["Hint.Select"]</option>
            <option value="1">@L["Status.Active"]</option>
            <option value="2">@L["Status.Leave"]</option>
            <option value="3">@L["Status.Resigned"]</option>
          </select>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:10px">
        <button type="submit" class="m-btn m-btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          @L["Btn.Update"]
        </button>
        <a class="m-btn m-btn-secondary" asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.Id">@L["Btn.Cancel"]</a>
      </div>
    </form>
  </div>

  @section Scripts {
  <script>
  function mPreviewImg(input){
    const file=input.files[0];if(!file)return;
    const reader=new FileReader();
    reader.onload=e=>{document.getElementById('mImgPreview').src=e.target.result;document.getElementById('mImgPreview').style.display='block'};
    reader.readAsDataURL(file);
  }
  </script>
  }
}
else
{
@section Breadcrumb {
  <div class="breadcrumb">
    <div class="page-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
    <a class="bc-link" asp-controller="Employee" asp-action="Index">@L["Page.EmployeeList"]</a>
    <span class="bc-sep">›</span>
    <a class="bc-link" asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.Id">@Model.FullName</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">@L["Page.EmployeeEdit"]</span>
  </div>
}
<style>.upload-zone{border:2px dashed var(--border);border-radius:50%;width:140px;height:140px;cursor:pointer;transition:all .2s;background:var(--bg);position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}.upload-zone:hover{border-color:var(--accent)}.upload-zone img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;border-radius:50%}.section-title{font-size:11px;font-weight:600;color:var(--text-soft);letter-spacing:.1em;text-transform:uppercase;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)}.en-badge{font-size:9px;background:#eef3fb;color:var(--accent);padding:1px 6px;border-radius:4px;font-weight:600}</style>
<div class="fade-up">
  <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div style="display:grid;grid-template-columns:200px 1fr;gap:24px;align-items:start">
      <div style="display:flex;flex-direction:column;align-items:center;gap:12px;padding-top:8px">
        <div class="upload-zone" onclick="document.getElementById('imgInput').click()">
          @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
          { <img src="@Model.ProfileImagePath" alt=""> }
          else
          { <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="opacity:.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg> }
          <img id="imgPreview" src="" alt="" style="display:none;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:50%">
        </div>
        <input type="file" id="imgInput" asp-for="ProfileImageFile" accept="image/*" style="display:none" onchange="previewImg(this)">
        <p style="font-size:11px;color:var(--text-soft)">@L["Label.ProfileImage"]</p>
      </div>
      <div class="form-card">
        <div class="form-card-header">@L["Page.EmployeeEdit"]</div>
        <div class="form-body">
          <div class="section-title">@L["Label.BasicInfo"]</div>
          <div class="form-group"><label class="form-label">@L["Label.EmployeeNo"]</label><input type="text" value="@Model.EmployeeNo" class="form-control" readonly style="background:#f7f7f5;color:var(--text-soft);cursor:not-allowed;font-family:var(--mono)"><small style="color:var(--text-soft);font-size:11px">🔒 @L["Msg.ReadOnly"]</small></div>
          <div class="form-group"><label class="form-label">@L["Label.FullName"]<span class="req">*</span></label><div class="form-row"><div><input asp-for="LastName" class="form-control" placeholder="@L["Label.LastName"]"><span asp-validation-for="LastName" class="field-validation-error"></span></div><div><input asp-for="FirstName" class="form-control" placeholder="@L["Label.FirstName"]"><span asp-validation-for="FirstName" class="field-validation-error"></span></div></div></div>
          <div class="form-group"><label class="form-label">@L["Label.FullName"] <span class="en-badge">EN</span></label><div class="form-row"><div><input asp-for="FirstNameEn" class="form-control" placeholder="e.g. Taro"></div><div><input asp-for="LastNameEn" class="form-control" placeholder="e.g. Yamada"></div></div><div style="font-size:11px;color:var(--text-soft);margin-top:4px">@L["Label.EnNameOptional"]</div></div>
          <div class="form-row"><div class="form-group"><label class="form-label">@L["Label.BirthDate"]<span class="req">*</span></label><input asp-for="BirthDate" type="date" class="form-control"><span asp-validation-for="BirthDate" class="field-validation-error"></span></div><div class="form-group"><label class="form-label">@L["Label.HireDate"]</label><input asp-for="HireDate" type="date" class="form-control"></div></div>
          <div class="section-title" style="margin-top:8px">@L["Label.Contact"]</div>
          <div class="form-group"><label class="form-label">@L["Label.Email"]<span class="req">*</span></label><input asp-for="Email" type="email" class="form-control"><span asp-validation-for="Email" class="field-validation-error"></span></div>
          <div class="form-group"><label class="form-label">@L["Label.Phone"]<span class="req">*</span></label><input asp-for="Phone" class="form-control" style="font-family:var(--mono)"><span asp-validation-for="Phone" class="field-validation-error"></span></div>
          <div class="section-title" style="margin-top:8px">@L["Label.Affiliation"]</div>
          <div class="form-row"><div class="form-group"><label class="form-label">@L["Label.Department"]<span class="req">*</span></label><select asp-for="DeptId" asp-items="ViewBag.Departments" class="form-control"><option value="">@L["Hint.Select"]</option></select></div><div class="form-group"><label class="form-label">@L["Label.Status"]<span class="req">*</span></label><select asp-for="Status" class="form-control"><option value="">@L["Hint.Select"]</option><option value="1">@L["Status.Active"]</option><option value="2">@L["Status.Leave"]</option><option value="3">@L["Status.Resigned"]</option></select></div></div>
          <div class="form-footer" style="margin:8px -28px -28px;padding:16px 28px"><a class="btn btn-secondary" asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.Id">@L["Btn.Cancel"]</a><button type="submit" class="btn btn-primary"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>@L["Btn.Update"]</button></div>
        </div>
      </div>
    </div>
  </form>
</div>
@section Scripts {<script>function previewImg(input){const file=input.files[0];if(!file)return;const reader=new FileReader();reader.onload=e=>{const prev=document.getElementById('imgPreview');prev.src=e.target.result;prev.style.display='block'};reader.readAsDataURL(file)}</script>}
}
