@model DepartmentViewModel
@{
    ViewData["Title"] = Model.LocalizedDeptName;
}

@if (ViewBag.IsMobile == true)
{
  <div class="m-fade-up">
    <!-- ヘッダーカード -->
    <div class="m-card" style="margin-bottom:12px">
      <div style="padding:24px;display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        { <img src="@Model.ImagePath" class="m-avatar m-avatar-xl" alt=""> }
        else
        { <div class="m-avatar m-avatar-xl" style="font-size:36px">@(Model.DeptName.FirstOrDefault().ToString())</div> }
        <div>
          <div style="font-size:20px;font-weight:700">@Model.LocalizedDeptName</div>
          @if (Model.LocalizedDeptName != Model.DeptName)
          { <div style="font-size:14px;color:var(--text-mid)">@Model.DeptName</div> }
          <div style="font-family:var(--mono);font-size:13px;color:var(--text-soft);margin-top:4px">@Model.DeptCode</div>
          @if (!string.IsNullOrEmpty(Model.Phone))
          { <div style="font-size:14px;color:var(--text-mid);margin-top:4px">📞 @Model.Phone</div> }
        </div>
      </div>
    </div>

    <!-- メンバー -->
    <div class="m-section-title">@L["Label.Members"] (@Model.Members.Count)</div>
    @if (Model.Members.Any())
    {
      <div class="m-card" style="margin-bottom:12px">
        @foreach (var member in Model.Members)
        {
          <a class="m-list-item" href="@Url.Action("Detail","Employee",new{id=member.Id})" style="display:flex">
            @if (!string.IsNullOrEmpty(member.ProfileImagePath))
            { <img src="@member.ProfileImagePath" class="m-avatar m-avatar-sm" alt=""> }
            else
            { <div class="m-avatar m-avatar-sm">@(member.LastName?.FirstOrDefault().ToString() ?? "?")</div> }
            <div class="m-list-body">
              <div class="m-list-title">@member.LocalizedFullName</div>
              <div class="m-list-sub">
                <span class="m-badge" style="background:@member.StatusBg;color:@member.StatusColor;padding:2px 8px;font-size:11px">@L[$"Status.{member.StatusCode}"]</span>
              </div>
            </div>
            <div class="m-list-right"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></div>
          </a>
        }
      </div>
    }
    else
    {
      <div class="m-card" style="margin-bottom:12px;padding:32px;text-align:center;color:var(--text-soft)">@L["Msg.NoMembers"]</div>
    }

    <!-- アクション -->
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px">
      <button type="button" class="m-btn" style="background:#f0f4fb;color:var(--accent);border:1.5px solid #c8d8f0" onclick="shareDept()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        共有
      </button>
      <a class="m-btn m-btn-secondary" asp-controller="Department" asp-action="Edit" asp-route-id="@Model.Id">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
        @L["Btn.Edit"]
      </a>
      <button type="button" class="m-btn m-btn-danger" onclick="showMDeleteModal()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        @L["Btn.Delete"]
      </button>
    </div>
  </div>

  <!-- 削除モーダル -->
  <div class="m-modal-overlay" id="mDeleteModal" onclick="if(event.target===this)hideMDeleteModal()">
    <div class="m-modal-sheet">
      <div class="m-modal-title">⚠️ @L["Btn.Delete"]</div>
      <div class="m-modal-body"><strong>@Model.LocalizedDeptName</strong> @L["Confirm.DeleteDept"]<br><span style="font-size:13px;color:var(--text-soft)">@L["Msg.DeleteConfirm"]</span></div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <form asp-controller="Department" asp-action="Delete" asp-route-id="@Model.Id" method="post">
          @Html.AntiForgeryToken()
          <button type="submit" class="m-btn m-btn-danger">@L["Btn.Delete"]</button>
        </form>
        <button type="button" class="m-btn m-btn-secondary" onclick="hideMDeleteModal()">@L["Btn.Cancel"]</button>
      </div>
    </div>
  </div>

  @section Scripts {
  <script>
  function showMDeleteModal(){document.getElementById('mDeleteModal').classList.add('show')}
  function hideMDeleteModal(){document.getElementById('mDeleteModal').classList.remove('show')}
  async function shareDept(){
    const name = '@Model.LocalizedDeptName';
    const code = '@Model.DeptCode';
    const url = window.location.href;
    if (navigator.share) {
      try {
        await navigator.share({
          title: name,
          text: `${name}（${code}）`,
          url: url
        });
      } catch(e) { if(e.name !== 'AbortError') copyToClipboard(url); }
    } else {
      copyToClipboard(url);
    }
  }
  function copyToClipboard(text){
    navigator.clipboard.writeText(text).then(()=>showCopiedToast()).catch(()=>{
      const ta=document.createElement('textarea');
      ta.value=text;document.body.appendChild(ta);
      ta.select();document.execCommand('copy');
      document.body.removeChild(ta);showCopiedToast();
    });
  }
  function showCopiedToast(){
    const t=document.createElement('div');
    t.className='m-toast-container';
    t.innerHTML='<div class="m-toast">🔗 リンクをコピーしました</div>';
    document.body.appendChild(t);
    setTimeout(()=>t.remove(),2500);
  }
  </script>
  }
}
else
{
@section Breadcrumb {
  <div class="breadcrumb">
    <div class="page-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div>
    <a class="bc-link" asp-controller="Department" asp-action="Index">@L["Page.DeptList"]</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">@Model.LocalizedDeptName</span>
  </div>
}
  <div class="fade-up" style="max-width:760px">
    <div class="card" style="margin-bottom:20px;padding:24px">
      <div style="display:flex;align-items:center;gap:20px">
        <div style="width:72px;height:72px;border-radius:50%;overflow:hidden;flex-shrink:0;border:2px solid var(--border)">
          @if (!string.IsNullOrEmpty(Model.ImagePath))
          { <img src="@Model.ImagePath" style="width:100%;height:100%;object-fit:cover" alt=""> }
          else
          { <div style="width:100%;height:100%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:700">@(Model.DeptName.FirstOrDefault().ToString())</div> }
        </div>
        <div style="flex:1">
          <div style="font-size:22px;font-weight:700;margin-bottom:2px">@Model.LocalizedDeptName</div>
          @if (Model.LocalizedDeptName != Model.DeptName)
          { <div style="font-size:14px;color:var(--text-soft);margin-bottom:2px">@Model.DeptName</div> }
          <div style="font-family:var(--mono);color:var(--text-soft);font-size:13px">@Model.DeptCode</div>
          @if (!string.IsNullOrEmpty(Model.Phone))
          { <div style="font-family:var(--mono);color:var(--text-mid);font-size:13px;margin-top:4px">📞 @Model.Phone</div> }
        </div>
        <div style="display:flex;gap:10px">
          <button type="button" class="btn btn-secondary btn-sm" onclick="pcShare()" title="共有">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            共有
          </button>
          <a class="btn btn-secondary btn-sm" asp-controller="Department" asp-action="Edit" asp-route-id="@Model.Id"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>@L["Btn.Edit"]</a>
          <button type="button" class="btn btn-danger btn-sm" onclick="showDeleteModal()"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>@L["Btn.Delete"]</button>
        </div>
      </div>
    </div>
    <div class="card" style="margin-bottom:20px;overflow:hidden">
      <div class="card-header"><span class="card-title">@L["Label.BasicInfo"]</span></div>
      <div class="info-grid">
        <div class="info-row"><div class="info-label">@L["Label.DeptCode"]</div><div class="info-value" style="font-family:var(--mono)">@Model.DeptCode</div></div>
        <div class="info-row"><div class="info-label">@L["Label.DeptName"]</div><div class="info-value">@Model.DeptName @if(!string.IsNullOrEmpty(Model.DeptNameEn)){<text><div style="font-size:12px;color:var(--text-soft)">@Model.DeptNameEn</div></text>}</div></div>
        <div class="info-row"><div class="info-label">@L["Label.Phone"]</div><div class="info-value" style="font-family:var(--mono)">@(Model.Phone ?? "—")</div></div>
      </div>
    </div>
    <div class="card" style="overflow:hidden">
      <div class="card-header"><span class="card-title">@L["Label.Members"]</span><span style="font-size:12px;color:var(--text-soft)">@Model.Members.Count @L["Label.Members"]</span></div>
      <div style="padding:20px">
        @if (Model.Members.Any())
        {
          <div class="members-grid">
            @foreach (var m in Model.Members)
            {
              <a class="member-chip" asp-controller="Employee" asp-action="Detail" asp-route-id="@m.Id">
                @if (!string.IsNullOrEmpty(m.ProfileImagePath))
                { <img src="@m.ProfileImagePath" style="width:30px;height:30px;border-radius:50%;object-fit:cover" alt=""> }
                else
                { <div class="member-av">@(m.LastName?.FirstOrDefault().ToString() ?? "?")</div> }
                <div><div style="font-size:13px;font-weight:500">@m.LocalizedFullName</div>@if(m.LocalizedFullName!=m.FullName){<div style="font-size:11px;color:var(--text-soft)">@m.FullName</div>}</div>
              </a>
            }
          </div>
        }
        else { <div class="empty-state" style="padding:30px 0"><div>@L["Msg.NoMembers"]</div></div> }
      </div>
    </div>
    <div class="card" style="overflow:hidden;margin-top:16px;background:#FAFAF8">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between">
        <span class="card-title">🕐 @L["Label.SystemInfo"]</span>
        <span style="font-size:11px;color:var(--text-soft);background:#fff;padding:3px 10px;border-radius:12px;border:1px solid var(--border)">🔒 @L["Label.ReadOnly"]</span>
      </div>
      <div class="info-grid" style="pointer-events:none;user-select:text">
        <div class="info-row"><div class="info-label">@L["Label.UpdatedBy"]</div><div class="info-value">@(string.IsNullOrEmpty(Model.UpdatedByName) ? L["Label.SystemAdmin"].Value : Model.UpdatedByName)</div></div>
        <div class="info-row"><div class="info-label">@L["Label.CreatedAt"]</div><div class="info-value" style="font-family:var(--mono);font-size:13px">@(Model.CreatedAt?.ToString("yyyy/MM/dd HH:mm:ss") ?? "—")</div></div>
        <div class="info-row"><div class="info-label">@L["Label.UpdatedAt"]</div><div class="info-value" style="font-family:var(--mono);font-size:13px">@(Model.UpdatedAt?.ToString("yyyy/MM/dd HH:mm:ss") ?? "—")</div></div>
      </div>
    </div>
  </div>
  <div id="deleteModal" style="position:fixed;inset:0;background:rgba(0,0,0,.4);backdrop-filter:blur(2px);z-index:500;display:none;align-items:center;justify-content:center" onclick="if(event.target===this)hideDeleteModal()">
    <div style="background:#fff;border-radius:16px;padding:32px;max-width:420px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.2)">
      <div style="font-size:16px;font-weight:700;margin-bottom:12px">⚠️ @L["Btn.Delete"]</div>
      <div style="font-size:14px;color:var(--text-mid);line-height:1.7;margin-bottom:24px"><strong>@Model.LocalizedDeptName</strong> @L["Confirm.DeleteDept"]<br><span style="font-size:12px;color:var(--text-soft)">@L["Msg.DeleteConfirm"]</span></div>
      <div style="display:flex;justify-content:flex-end;gap:10px">
        <button type="button" class="btn btn-secondary" onclick="hideDeleteModal()">@L["Btn.Cancel"]</button>
        <form asp-controller="Department" asp-action="Delete" asp-route-id="@Model.Id" method="post" style="margin:0">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn-danger">@L["Btn.Delete"]</button>
        </form>
      </div>
    </div>
  </div>
  @section Scripts {<script>function showDeleteModal(){document.getElementById('deleteModal').style.display='flex'}function hideDeleteModal(){document.getElementById('deleteModal').style.display='none'}document.addEventListener('keydown',e=>{if(e.key==='Escape')hideDeleteModal()})</script>}
}
