@if (TempData["Success"] != null)
{
  <div class="toast-container">
    <div class="toast">✓ @TempData["Success"]</div>
  </div>
  <script>setTimeout(()=>{const t=document.querySelector('.toast-container');if(t)t.remove()},3000)</script>
}

<!-- ログアウト確認モーダル -->
<div id="logoutModal" style="position:fixed;inset:0;background:rgba(0,0,0,.4);backdrop-filter:blur(2px);z-index:500;display:none;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;padding:32px;max-width:380px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.2)">
    <div style="font-size:16px;font-weight:700;margin-bottom:8px">@L["Nav.Logout"]</div>
    <div style="font-size:14px;color:var(--text-mid);margin-bottom:24px;line-height:1.7">@L["Nav.LogoutConfirm"]</div>
    <div style="display:flex;justify-content:flex-end;gap:10px">
      <button type="button" class="btn btn-secondary" onclick="closeLogout()">@L["Btn.Cancel"]</button>
      <button type="button" class="btn btn-danger" onclick="document.getElementById('logoutForm').submit()">@L["Nav.Logout"]</button>
    </div>
  </div>
</div>

<!-- 言語ドロップダウン -->
<div class="lang-overlay" id="langOverlay" onclick="closeLang()"></div>
<div class="lang-dropdown" id="langDropdown">
  <div class="lang-dropdown-header">言語を選択 / Select Language</div>
</div>

<script>
const LANGS=[
  {code:'ja',culture:'ja',flag:'🇯🇵',label:'日本語',sub:'Japanese',short:'JP'},
  {code:'en',culture:'en',flag:'🇺🇸',label:'English',sub:'English',short:'EN'},
  {code:'zh-TW',culture:'zh-TW',flag:'🇹🇼',label:'繁體字',sub:'Traditional',short:'TW'},
  {code:'zh-CN',culture:'zh-CN',flag:'🇨🇳',label:'简体字',sub:'Simplified',short:'CN'},
  {code:'ko',culture:'ko',flag:'🇰🇷',label:'한국어',sub:'Korean',short:'KR'},
  {code:'es',culture:'es',flag:'🇪🇸',label:'Español',sub:'Spanish',short:'ES'},
  {code:'fr',culture:'fr',flag:'🇫🇷',label:'Français',sub:'French',short:'FR'},
  {code:'de',culture:'de',flag:'🇩🇪',label:'Deutsch',sub:'German',short:'DE'},
  {code:'pt',culture:'pt',flag:'🇧🇷',label:'Português',sub:'Portuguese',short:'PT'},
  {code:'it',culture:'it',flag:'🇮🇹',label:'Italiano',sub:'Italian',short:'IT'},
  {code:'vi',culture:'vi',flag:'🇻🇳',label:'Tiếng Việt',sub:'Vietnamese',short:'VI'},
  {code:'th',culture:'th',flag:'🇹🇭',label:'ภาษาไทย',sub:'Thai',short:'TH'},
];
const currentCulture='@currentCulture';
function buildLangMenu(){
  const dd=document.getElementById('langDropdown');
  const hdr=dd.querySelector('div');
  dd.innerHTML=''; dd.appendChild(hdr);
  LANGS.forEach(l=>{
    const isActive=currentCulture.startsWith(l.code)||l.code===currentCulture;
    const opt=document.createElement('div');
    opt.className='lang-option'+(isActive?' active':'');
    opt.innerHTML=`<span class="lang-flag">${l.flag}</span><span class="lang-label-main">${l.label}</span><span class="lang-label-sub">${l.sub}</span><span class="lang-check">✓</span>`;
    opt.onclick=()=>selectLang(l);
    dd.appendChild(opt);
    if(isActive)document.getElementById('langLabel').textContent=l.short;
  });
}
function toggleLang(){
  const btn=document.getElementById('langBtn'),dd=document.getElementById('langDropdown');
  if(dd.classList.contains('show')){closeLang();return}
  const r=btn.getBoundingClientRect();
  dd.style.top=(r.bottom+6)+'px'; dd.style.right=(window.innerWidth-r.right)+'px';
  document.getElementById('langOverlay').classList.add('show');
  dd.classList.add('show'); btn.classList.add('open');
}
function closeLang(){
  document.getElementById('langOverlay').classList.remove('show');
  document.getElementById('langDropdown').classList.remove('show');
  document.getElementById('langBtn').classList.remove('open');
}
function selectLang(l){
  closeLang();
  const returnUrl=encodeURIComponent(window.location.pathname+window.location.search);
  window.location.href='/Culture/Set?culture='+encodeURIComponent(l.culture)+'&returnUrl='+returnUrl;
}
function confirmLogout(){document.getElementById('logoutModal').style.display='flex'}
function closeLogout(){document.getElementById('logoutModal').style.display='none'}
document.addEventListener('DOMContentLoaded',buildLangMenu);
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeLang();closeLogout()}});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
