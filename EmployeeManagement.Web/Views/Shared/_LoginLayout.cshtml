<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ログイン — 社員情報管理システム</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f3f3f1;--white:#fff;--border:#e2e0dc;
  --text-dark:#1a1a1a;--text-mid:#555;--text-soft:#999;
  --accent:#2b5ba5;--danger:#c53030;
  --radius-sm:6px;--radius-md:10px;--radius-lg:16px;
  --font:'Noto Sans JP',sans-serif;--mono:'DM Mono',monospace;
  --tr:150ms ease;
}
html,body{min-height:100%;background:var(--bg);font-family:var(--font);color:var(--text-dark);font-size:14px}
@@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@@keyframes shake{0%,100%{transform:translateX(0)}15%{transform:translateX(-8px)}30%{transform:translateX(8px)}45%{transform:translateX(-6px)}60%{transform:translateX(6px)}75%{transform:translateX(-3px)}90%{transform:translateX(3px)}}
</style>
</head>
<body>
@RenderBody()
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
